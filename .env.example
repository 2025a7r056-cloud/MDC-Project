# ==============================================================================
# CRIMEGRAPH AI - Criminal Network Intelligence Platform
# Environment Configuration
# ==============================================================================

# Application Environment & Deployment
NODE_ENV=development
NEXT_PUBLIC_APP_NAME="CRIMEGRAPH AI"
NEXT_PUBLIC_APP_VERSION="1.4.0"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Intelligence System Security & Classification
NEXT_PUBLIC_SECURITY_CLASSIFICATION="CONFIDENTIAL // LAW ENFORCEMENT SENSITIVE"
NEXT_PUBLIC_DEMO_MODE=true

# Authentication & Session (Optional Supabase / NextAuth)
# Leave blank to use built-in deterministic RBAC demo mode (Analyst, Lead Investigator, Forensic Auditor, Admin)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
AUTH_SECRET=crimegraph-super-secure-production-secret-min32chars

# AI Investigation Assistant Engine
# Leave blank to use built-in deterministic analytical graph-reasoning engine
# Provide an API key to enable live external LLM analysis
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Audit Logging & Compliance Retention (Days)
AUDIT_LOG_RETENTION_DAYS=90
REQUIRE_HUMAN_IN_THE_LOOP_VERIFICATION=true
